# Cikal community site credentials
CIKAL_USERNAME=your_email@example.com
CIKAL_PASSWORD=your_password

# Discord webhook URL (backup — see README for how to create one)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXX

# ntfy.sh topic for iPhone push notifications (primary)
# Pick a hard-to-guess name, e.g. cikal-yourname-abc123
NTFY_TOPIC=cikal-yourname-abc123
# Optional: set to your self-hosted ntfy URL, otherwise uses https://ntfy.sh
# NTFY_URL=https://ntfy.sh

# Set to true to save screenshots on each run (for debugging)
DEBUG=false
